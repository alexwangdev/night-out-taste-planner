# Names only — never commit real values.
# Locally: put these in server/.env or the repo-root .env (both are git-ignored).
# On Render: set them in the service's Environment tab.
QLOO_API_KEY=
# Optional: defaults to https://hackathon.api.qloo.com (the host issued with the hackathon key).
QLOO_BASE_URL=
NEBIUS_API_KEY=
# Optional model overrides (defaults come from devpost/model-benchmark.md):
# NEMOTRON_MOOD_MODEL=nvidia/Nemotron-3_5-Lightning
# NEMOTRON_SELECT_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NEMOTRON_FALLBACK_MODEL=nvidia/Nemotron-3_5-Lightning
# NEMOTRON_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# NEMOTRON_MEMORY_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Browser origin allowed to call the API, e.g. https://your-app.vercel.app (comma-separate several).
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
# Optional: proxy hops to trust for the client IP. Defaults to 1 on Render, 0 locally.
TRUST_PROXY_HOPS=
# Optional: set to 1 briefly after deploying to log the forwarded IP once, then remove it.
DEBUG_IP=

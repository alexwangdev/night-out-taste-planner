{
  "name": "cozy-night-planner-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx --watch-path=src src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "tsx src/scripts/check-budget.ts",
    "probe": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/scripts/probe.ts",
    "bench": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/scripts/bench-models.ts",
    "eval": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/scripts/eval-grounding.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2"
  }
}
